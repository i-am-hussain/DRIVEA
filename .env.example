# ---------------------------------------------------------------------------
# Server (this file lives at the repository root and is read by the API)
# ---------------------------------------------------------------------------

# MongoDB connection string. Leave this unset during local development to use
# an ephemeral in-memory MongoDB (data is lost when the API restarts).
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/drivea

# Secret used to sign session tokens. Use a long random value in production.
JWT_SECRET=change_me_to_a_long_random_string

# Storage quota in bytes assigned to newly registered users (default 1 GB).
STORAGE_LIMIT_BYTES=1073741824

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------

# When set, uploads go to Vercel Blob instead of the local .uploads/ folder.
# Required in production (serverless filesystems are ephemeral).
BLOB_READ_WRITE_TOKEN=

# Optional: custom domain used only when a stored blob URL is not absolute.
VERCEL_BLOB_DOMAIN=

# ---------------------------------------------------------------------------
# Client
# ---------------------------------------------------------------------------

# VITE_* variables are read by Vite from client/.env, not from this file.
# The SPA defaults to /api, which the dev server proxies to localhost:4000.
# Only set this if the API runs on another origin without a proxy:
# VITE_API_URL=http://localhost:4000/api
